---
import Layout from '../../layouts/Layout.astro';

const title = 'Loading Spinner';
---

<Layout title={title} currentPage="browse">
  <div class="spinner-test-page">
    <h1>Loading Spinner</h1>
    <p>
      Dots struck like notes, with human timing. The standard spinner shows
      while a page or section loads; the compact one shows in buttons.
    </p>

    <section class="demo-section">
      <h2>Standard</h2>
      <p>Muted, as on the library page while scores load.</p>
      <div class="demo-row">
        <div class="demo-item demo-muted" data-spinner="standard"></div>
        <div class="demo-item demo-inverted" data-spinner="standard"></div>
      </div>
    </section>

    <section class="demo-section">
      <h2>Compact, in buttons</h2>
      <p>Click a button to show its spinner for three seconds.</p>
      <div class="button-demo-row" data-click-demo>
        <button class="btn btn-primary" type="button">
          <span class="btn-text">Save</span>
        </button>
        <button class="btn btn-secondary" type="button">
          <span class="btn-text">Fork</span>
        </button>
        <button class="btn btn-neutral" type="button">
          <span class="btn-text">Delete</span>
        </button>
        <button class="btn btn-primary btn-small" type="button">
          <span class="btn-text">Small</span>
        </button>
        <button
          class="btn btn-icon"
          type="button"
          aria-label="Upload"
          title="Show the spinner"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </button>
      </div>
    </section>

    <section class="demo-section">
      <h2>Compact, loading</h2>
      <p>The same buttons, held in their loading state.</p>
      <div class="button-demo-row" data-loading-demo>
        <button class="btn btn-primary" type="button">
          <span class="btn-text">Save</span>
        </button>
        <button class="btn btn-secondary" type="button">
          <span class="btn-text">Fork</span>
        </button>
        <button class="btn btn-neutral" type="button">
          <span class="btn-text">Delete</span>
        </button>
        <button class="btn btn-primary btn-small" type="button">
          <span class="btn-text">Small</span>
        </button>
        <button class="btn btn-icon" type="button" aria-label="Upload">
          <svg
            xmlns="http://www.w3.org/2000/svg"
            width="16"
            height="16"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="17 8 12 3 7 8"></polyline>
            <line x1="12" y1="3" x2="12" y2="15"></line>
          </svg>
        </button>
      </div>
    </section>
  </div>
</Layout>

<style>
  .spinner-test-page {
    max-width: 860px;
    margin: 0 auto;
  }

  .spinner-test-page h1 {
    font-size: var(--font-size-x-large);
    margin: 0;
  }

  .spinner-test-page > p,
  .demo-section > p {
    color: var(--color-text-secondary);
    margin: 0 0 var(--spacing-medium);
  }

  .demo-section {
    border: 1px solid var(--color-border);
    border-radius: var(--border-radius-medium);
    padding: var(--spacing-small) var(--spacing-large);
  }

  .demo-section + .demo-section {
    margin-top: var(--spacing-small);
  }

  .demo-section h2 {
    font-size: var(--font-size-large);
    margin: 0 0 var(--spacing-2x-small);
  }

  .demo-row {
    display: flex;
  }

  .demo-item {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 50%;
    padding: var(--spacing-3x-large) var(--spacing-large);
  }

  .demo-muted {
    color: var(--color-text-tertiary);
  }

  .demo-inverted {
    background: var(--color-text-primary);
    color: var(--page-background-color);
    border-radius: 0 var(--border-radius-medium) var(--border-radius-medium) 0;
  }

  .button-demo-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--spacing-small);
    align-items: center;
    margin-bottom: var(--spacing-small);
  }
</style>

<script>
  import { Pane } from 'tweakpane';
  import {
    buildSpinnerSVG,
    ButtonLoadingState,
  } from '../../components/LoadingSpinner';

  document.querySelectorAll('[data-spinner="standard"]').forEach((el) => {
    el.innerHTML = buildSpinnerSVG();
  });

  document
    .querySelectorAll<HTMLButtonElement>('[data-click-demo] .btn')
    .forEach((btn) => {
      const state = new ButtonLoadingState(btn);
      btn.addEventListener('click', () => {
        state.show();
        setTimeout(() => state.hide(), 3000);
      });
    });

  document
    .querySelectorAll<HTMLButtonElement>('[data-loading-demo] .btn')
    .forEach((btn) => new ButtonLoadingState(btn).show());

  // Try dot sizes in place. This overrides the tokens on this page only; the
  // shipped sizes are --size-spinner-dot (with its mobile value) and
  // --size-spinner-compact-dot in theme.css.
  const root = document.documentElement;
  const px = (token: string) =>
    parseFloat(getComputedStyle(root).getPropertyValue(token)) * 16;
  const sizes = {
    standard: px('--size-spinner-dot'),
    compact: px('--size-spinner-compact-dot'),
  };
  const pane = new Pane({ title: 'Dot sizes (px)' });
  pane
    .addBinding(sizes, 'standard', { min: 4, max: 16, step: 1 })
    .on('change', ({ value }) =>
      root.style.setProperty('--size-spinner-dot', `${value / 16}rem`),
    );
  pane
    .addBinding(sizes, 'compact', { min: 4, max: 14, step: 1 })
    .on('change', ({ value }) =>
      root.style.setProperty('--size-spinner-compact-dot', `${value / 16}rem`),
    );
</script>
