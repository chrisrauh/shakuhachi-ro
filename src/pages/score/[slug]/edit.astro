---
import Layout from '../../../layouts/Layout.astro';
import PageHeader from '../../../components/PageHeader.astro';
import DetailsDialog from '../../../components/score-editor/DetailsDialog.astro';
import PalettePanel from '../../../components/score-editor/PalettePanel.astro';
import { getScoreBySlug } from '../../../api/scores';
import { embedJson } from '../../../utils/embed-json';
import { ArrowRightLeft, CircleAlert, CircleQuestionMark } from '@lucide/astro';
import '../../../styles/score-editor.css';

const { slug } = Astro.params;
if (!slug) return Astro.redirect('/');

const scoreResult = await getScoreBySlug(slug);
const { score } = scoreResult;

// 404 if score not found (no more create mode via this route)
if (!score) return new Response(null, { status: 404 });

const formats = [
  { value: 'json', label: 'JSON' },
  { value: 'musicxml', label: 'MusicXML' },
  { value: 'abc', label: 'ABC' },
];
---

<Layout
  title={`Edit ${score.title}`}
  currentPage="score"
  fullHeight={true}
  fullHeightOnMobile={true}
  preconnectSupabase
>
  <PageHeader slot="header-metadata" title={`Edit ${score.title}`} />

  <div class="score-editor">
    <div class="editor-toolbar" role="toolbar" aria-label="Score editor">
      <button
        type="button"
        id="details-btn"
        class="btn btn-small btn-secondary"
      >
        <span class="btn-text">Details</span>
      </button>
      <button type="button" id="source-toggle" class="btn btn-link">
        <span class="btn-text">Source</span>
      </button>
      <button
        type="button"
        id="palette-side-toggle"
        class="btn btn-icon palette-side-toggle"
        aria-label="Move palettes to the left"
        title="Move the palettes to the left side"
      >
        <ArrowRightLeft size={16} />
      </button>
      <span id="save-status" class="save-status" role="status"></span>
      <button type="button" id="save-btn" class="btn btn-small btn-primary">
        <span class="btn-text">Save</span>
      </button>
    </div>

    <p class="editor-status" id="editor-status" aria-live="polite">
      <strong class="editor-status-mode" id="status-mode"></strong>
      <span id="status-detail"></span>
    </p>

    <div
      class="editor-workspace"
      id="editor-workspace"
      data-palette-side="right"
    >
      <div class="editor-score-area" id="score-area">
        <div class="editor-score-canvas" id="score-canvas">
          <div class="score-highlight" id="score-highlight" hidden></div>
          <shakuhachi-score id="score-renderer" columns="1"></shakuhachi-score>
          <div class="score-cursor" id="score-cursor" hidden></div>
        </div>
        <p class="editor-empty-hint" id="score-empty-hint" hidden>
          An empty score. Choose a note to start.
        </p>
      </div>

      <section
        class="editor-source"
        id="source-view"
        aria-label="Score source"
        hidden
      >
        <div class="editor-source-header">
          <div class="format-toggle" role="radiogroup" aria-label="Format">
            {formats.map(({ value, label }) => (
              <label>
                <input
                  type="radio"
                  name="format"
                  value={value}
                  checked={value === score.data_format}
                />
                {label}
              </label>
            ))}
          </div>
          <a
            href="/help/notation-formats"
            target="_blank"
            class="help-link"
            aria-label="Format help"
            title="How to write JSON, MusicXML and ABC scores"
          >
            <CircleQuestionMark size={16} />
          </a>
        </div>
        <div class="validation-error" id="validation-error" hidden>
          <CircleAlert size={16} />
          <span id="validation-message"></span>
        </div>
        <textarea
          id="score-data-input"
          aria-label="Score source"
          spellcheck="false"
        ></textarea>
      </section>

      <PalettePanel />
    </div>
  </div>

  <DetailsDialog score={score} />

  <!-- Always embed score data — safe because 404 above ensures score is non-null.
       embedJson, not JSON.stringify: score fields are user-supplied and
       JSON.stringify does not escape `</script`. -->
  <script
    id="score-data"
    type="application/json"
    is:inline
    set:html={embedJson({ score })}
  ></script>
  <script is:inline src="/embed/shakuhachi-score.js"></script>
  <script>
    import { ScoreEditor } from '../../../components/score-editor/ScoreEditor';
    import { onAuthReady } from '../../../api/auth';
    import { toast } from '../../../components/Toast';
    import { STRINGS } from '../../../constants/strings';
    import type { Score } from '../../../api/scores';

    const { score } = JSON.parse(
      document.getElementById('score-data')!.textContent!,
    ) as { score: Score };

    // Only the owner can save (RLS enforces it); send anyone else to the score
    onAuthReady((user) => {
      if (!user) {
        window.location.href = `/score/${score.slug}`;
        return;
      }

      if (user.id !== score.user_id) {
        toast.error(STRINGS.ERRORS.ScoreEditor.editPermissionDenied, {
          duration: 2000,
        });
        setTimeout(() => {
          window.location.href = `/score/${score.slug}`;
        }, 2000);
      }
    });

    new ScoreEditor(score);
  </script>
</Layout>
