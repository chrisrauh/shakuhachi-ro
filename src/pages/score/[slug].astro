---
import Layout from '../../layouts/Layout.astro';
import PageHeader from '../../components/PageHeader.astro';
import Error404 from '../../components/Error404.astro';
import { getScoreBySlug } from '../../api/scores';
import { cacheTagForScore } from '../../utils/cache-tags';
import { embedJson } from '../../utils/embed-json';
import { LICENSES, musicCredit } from '../../utils/license';
import { GitFork, SquarePen, Trash } from '@lucide/astro';

// In server mode, this page SSRs all routes dynamically
// (getStaticPaths not used - all score URLs render on-demand)
const { slug } = Astro.params;

if (!slug) {
  return Astro.redirect('/');
}

// Server-side fetch
const scoreResult = await getScoreBySlug(slug);
const { score } = scoreResult;

if (!score) {
  Astro.response.status = 404;
} else {
  // Serve repeat views from Netlify's edge instead of re-rendering here. The
  // functions run in N. Virginia and the database is in Paris, so every render
  // crosses the Atlantic three times — a cache hit crosses none (#385).
  //
  // Netlify-CDN-Cache-Control, not Cache-Control: this applies to Netlify's CDN
  // alone, so browsers keep revalidating and a purge reaches every viewer at once.
  //
  // max-age is only the backstop for a missed purge — the tag below is what keeps
  // edits immediately visible, which is why these pages are SSR in the first place
  // (docs/ARCHITECTURE-PLATFORM.MD). stale-while-revalidate is what makes a short
  // max-age cheap: past it the edge serves the stale copy at once and refreshes
  // behind the request, so nobody waits for the round trip.
  Astro.response.headers.set(
    'Netlify-CDN-Cache-Control',
    'public, max-age=300, stale-while-revalidate=86400, durable',
  );
  // Netlify-Cache-Tag rather than Cache-Tag: Netlify prefers it when both are
  // present, and keeps it internal instead of passing it on to the client.
  Astro.response.headers.set('Netlify-Cache-Tag', cacheTagForScore(score.slug));
}

// The parent of a fork arrives embedded in the query above — no second round trip.
const parentScore = score?.parent ?? null;

// The two rights layers (#306), as one credit line under the score: the music's
// copyright status and the licence on this score's notation. NOASSERTION means
// no licence is established yet, so that half is left off.
const credit = score
  ? musicCredit(score.composition_copyright_status, score.composer)
  : null;
const license =
  score && score.license !== 'NOASSERTION' ? LICENSES[score.license] : null;
---

{score ? (
  <Layout
    title={`${score.title} - Shakuhachi Score Library`}
    currentPage="score"
    fullHeight={true}
    mobileMenuType="score-edit"
  >
    <!-- Score metadata in header -->
    <PageHeader slot="header-metadata" title={score.title}>
      {parentScore ? (
        <span>
          forked from{' '}
          <a href={`/score/${parentScore.slug}`}>{parentScore.title}</a>
        </span>
      ) : (
        <span class="score-stat">
          updated{' '}
          <relative-time
            datetime={score.updated_at}
            format="relative"
          ></relative-time>
        </span>
      )}
    </PageHeader>

    <!-- Header actions (right side of navbar) -->
    <div
      slot="header-actions"
      style="display: flex; gap: var(--spacing-small); align-items: center;"
    >
      <!-- Owner-only edit button -->
      <a
        href={`/score/${score.slug}/edit`}
        class="btn btn-icon owner-btn"
        id="edit-btn"
        aria-label="Edit score"
        title="Open this score in the editor"
      >
        <SquarePen size={16} />
      </a>

      <!-- Owner-only delete button -->
      <button
        id="delete-btn"
        class="btn btn-icon owner-btn"
        aria-label="Delete score"
        title="Permanently delete this score"
      >
        <Trash size={16} />
      </button>

      <!-- Fork button -->
      <button
        id="fork-btn"
        class="btn btn-icon-with-count"
        aria-label="Fork this score"
        title="Create your own editable copy of this score"
      >
        <GitFork size={16} />
        <span class="count">{score.fork_count}</span>
      </button>
    </div>

    <!-- Score content -->
    <div class="score-detail-container">
      <!-- Score renderer using web component -->
      <shakuhachi-score id="score-renderer"></shakuhachi-score>

      {(credit || license) && (
        <p class="score-credit">
          {credit && <span class="score-credit-part">{credit}</span>}
          {credit && license && <span class="score-credit-separator">·</span>}
          {license && (
            <span class="score-credit-part">
              {license.url ? (
                <>
                  Score licensed under{' '}
                  <a
                    href={license.url}
                    rel="license noopener noreferrer"
                    target="_blank"
                  >
                    {license.name}
                  </a>
                </>
              ) : (
                `Score: ${license.name.toLowerCase()}`
              )}
            </span>
          )}
        </p>
      )}
    </div>

    <!-- Embed score data for client. embedJson, not JSON.stringify: score fields are
       user-supplied and JSON.stringify does not escape `</script`. -->
    <script
      id="score-data"
      type="application/json"
      is:inline
      set:html={embedJson({ score })}
    ></script>
    <!-- Load web component for score rendering -->
    <script is:inline src="/embed/shakuhachi-score.js"></script>
    <!-- Initialize relative-time web component -->
    <script>
      import '@github/relative-time-element';
    </script>
    <!-- Client-side logic -->
    <script>
      import { ScoreDetailClient } from '../../components/ScoreDetailClient';
      const client = new ScoreDetailClient();
      client.init();
    </script>
  </Layout>
) : (
  <Layout title="Page Not Found - Shakuhachi.ro" currentPage="score">
    <PageHeader slot="header-metadata" title="Page Not Found" />
    <Error404 />
  </Layout>
)}

<style>
  :global(.metadata-separator) {
    color: var(--color-separator);
  }

  :global(.score-stat) {
    display: inline-flex;
    align-items: center;
    gap: var(--spacing-3x-small);
  }

  /* Links in metadata are copy, not calls to action: one step more contrast
     than the text around them, and the underline says they are links. */
  :global(.score-header-metadata a),
  .score-credit a {
    color: var(--color-text-primary);
    text-decoration: underline;
    text-underline-offset: var(--spacing-3x-small);
  }

  /* Page content styling */
  .score-detail-container {
    width: 100%; /* Fill viewport width */
    max-width: 1200px;
    margin: 0 auto;
    padding: var(--spacing-medium) var(--spacing-medium) 0;
    position: relative;
    flex: 1;
    min-height: 0; /* Shrink to main's height, so nothing is clipped below */
    display: flex;
    flex-direction: column;
    box-sizing: border-box; /* Include padding in width calculation */
  }

  #score-renderer {
    /* Flex child - fills available space in parent flex container */
    flex: 1;
    /* Needed for custom elements to participate in flex layout */
    display: block;
    min-height: 0; /* Allow flex shrinking */
    /* Fill parent dimensions (parent is flex container) */
    width: 100%;
    align-self: stretch; /* Stretch to fill cross axis */
  }

  /* Footnote to the score, not a competitor for attention: one quiet line,
     no louder than the header's metadata. */
  .score-credit {
    flex-shrink: 0; /* The score gives up the space, not the credit */
    margin-top: var(--spacing-small);
    padding-bottom: var(--spacing-medium);
    color: var(--color-text-secondary);
    font-size: var(--font-size-small); /* Matches the header's metadata */
    line-height: var(--line-height-dense);
    text-align: center;
  }

  .score-credit-separator {
    margin: 0 var(--spacing-x-small);
    color: var(--color-separator);
  }

  @media (max-width: 768px) {
    :global(.score-header-metadata) {
      flex-direction: column;
      align-items: flex-start;
      gap: var(--spacing-2x-small);
    }

    :global(.score-title) {
      font-size: var(--font-size-medium);
    }

    /* Follows the header's metadata down a size and into a column
       (PageHeader.astro): one half per line, so no separator is needed */
    .score-credit {
      font-size: var(--font-size-x-small);
    }

    .score-credit-part {
      display: block;
    }

    .score-credit-separator {
      display: none;
    }

    /* Hide owner buttons on mobile — shown in menu instead */
    :global(.btn.owner-btn.owner-visible) {
      display: none;
    }

    .floating-edit-btn {
      top: 120px;
      right: var(--spacing-medium);
    }

    /* Mobile score rendering - allow natural height expansion */
    .score-detail-container {
      flex: none; /* Remove flex constraint */
      overflow: visible; /* Allow content to overflow viewport */
      max-width: 100%; /* Constrain to viewport width */
      display: flex;
      flex-direction: column;
      align-items: center; /* Center intrinsic-width components (columns="1" uses 140px intrinsic width) */
    }

    #score-renderer {
      /* Remove width constraint to allow intrinsic sizing */
      width: auto;
      flex: none;
      align-self: auto; /* Don't stretch - let intrinsic width work */
    }

    #score-renderer-container {
      flex: none; /* Remove flex constraint */
      min-height: auto; /* Allow natural height */
      width: 100%; /* Full width of container */
    }
  }
</style>
