---
import SiteHeader from '../components/SiteHeader.astro';
import '../styles/theme.css';
import '../styles/components.css';
import '../styles/dialogs.css';

interface Props {
  title: string;
  currentPage: 'browse' | 'create' | 'score';
  fullHeight?: boolean;
  // Keeps the fullHeight layout on phones too, where it otherwise reverts to
  // document scrolling. For pages whose content scrolls inside a fixed frame,
  // such as the score editor, whose palette floats over a scrolling score.
  fullHeightOnMobile?: boolean;
  noPadding?: boolean;
  mobileMenuType?: 'standard' | 'score-edit';
  // For pages whose scripts call Supabase as soon as they load: opens the
  // connection while the scripts download. Pages that call it only on user
  // action leave it off, so no connection is opened unused.
  preconnectSupabase?: boolean;
}

const {
  title,
  currentPage: _currentPage,
  fullHeight = false,
  fullHeightOnMobile = false,
  noPadding = false,
  mobileMenuType,
  preconnectSupabase = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    {preconnectSupabase && (
      <link
        rel="preconnect"
        href={import.meta.env.VITE_SUPABASE_URL}
        crossorigin
      />
    )}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@400&family=Noto+Sans+JP:wght@100..900&family=Noto+Serif+JP:wght@400;500&display=swap"
      rel="stylesheet"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-light.svg"
      media="(prefers-color-scheme: light)"
    />
    <link
      rel="icon"
      type="image/svg+xml"
      href="/favicon-dark.svg"
      media="(prefers-color-scheme: dark)"
    />
    <script is:inline>
      // Prevent flash of wrong theme - runs before body renders
      (function () {
        var prefersDark = window.matchMedia(
          '(prefers-color-scheme: dark)',
        ).matches;
        document.documentElement.setAttribute(
          'data-theme',
          prefersDark ? 'dark' : 'light',
        );

        // Notation font preference persists across sessions
        var notationFont = 'sans';
        try {
          notationFont =
            localStorage.getItem('notation-font') === 'serif'
              ? 'serif'
              : 'sans';
        } catch (e) {
          // Private mode or blocked storage - fall back to the default
        }
        document.documentElement.setAttribute(
          'data-notation-font',
          notationFont,
        );
      })();
    </script>
  </head>
  <body
    class:list={{
      'full-height': fullHeight,
      'full-height-on-mobile': fullHeight && fullHeightOnMobile,
    }}
  >
    <SiteHeader mobileMenuType={mobileMenuType}>
      <slot name="header-metadata" slot="header-metadata" />
      <slot name="header-actions" slot="header-actions" />
    </SiteHeader>

    <main class={noPadding ? 'no-padding' : ''}>
      <slot />
    </main>

    <!-- Dev Tools (only rendered in dev mode) -->
    {import.meta.env.DEV && (
      <div class="dev-controls">
        <div id="letter-spacing-control" class="dev-panel"></div>
      </div>
    )}

    <style is:global>
      /* ONLY OVERRIDE: Font family to use Noto Sans JP */
      :root {
        --font-sans:
          'Noto Sans JP', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto,
          sans-serif;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: var(--font-sans);
        background: var(--page-background-color);
        color: var(--color-text-primary);
        min-height: 100vh;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        letter-spacing: var(--letter-spacing-override, normal);
      }

      body.full-height {
        height: 100vh;
        display: flex;
        flex-direction: column;
      }

      body.full-height main {
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
      }

      /* On mobile, revert to natural document scrolling */
      @media (max-width: 768px) {
        body.full-height:not(.full-height-on-mobile) {
          height: auto;
          min-height: 100vh;
        }

        body.full-height:not(.full-height-on-mobile) main {
          flex: none;
          overflow: visible;
        }
      }

      /* The visible viewport, not 100vh, which on phones includes the area
         under the browser's toolbars and would push the bottom out of view */
      body.full-height-on-mobile {
        height: 100dvh;
      }

      main {
        padding: var(--spacing-medium);
      }

      main.no-padding {
        padding: 0;
      }

      /* Loading state for Plus button */
      .btn.loading {
        opacity: 0.6;
        pointer-events: none;
      }

      /* Dev controls - fixed column stack, bottom-right */
      .dev-controls {
        position: fixed;
        bottom: var(--spacing-medium);
        right: var(--spacing-medium);
        z-index: 100;
        display: flex;
        flex-direction: column;
        gap: var(--spacing-x-small);
        max-width: 280px;
      }

      /* Tweakpane theme integration: its defaults are a dark theme, so every
         colour it uses is mapped, or light mode mixes light and dark parts */
      .dev-panel {
        --tp-base-background-color: var(--color-bg-subtle);
        --tp-container-background-color: var(--color-bg-hover);
        --tp-container-background-color-hover: var(--color-bg-active);
        --tp-container-background-color-focus: var(--color-bg-active);
        --tp-container-background-color-active: var(--color-bg-active);
        --tp-container-foreground-color: var(--color-text-primary);
        --tp-input-background-color: var(--color-bg-hover);
        --tp-input-background-color-hover: var(--color-bg-active);
        --tp-input-background-color-focus: var(--color-bg-active);
        --tp-input-background-color-active: var(--color-bg-active);
        --tp-input-foreground-color: var(--color-text-primary);
        --tp-button-background-color: var(--color-button-secondary);
        --tp-button-background-color-hover: var(--color-button-secondary-hover);
        --tp-button-background-color-focus: var(--color-button-secondary-hover);
        --tp-button-background-color-active: var(
          --color-button-secondary-hover
        );
        --tp-button-foreground-color: var(--color-text-primary);
        --tp-label-foreground-color: var(--color-text-secondary);
        --tp-groove-foreground-color: var(--color-border);
      }

      .dev-panel .tp-rotv_c {
        border: 1px solid var(--color-border);
        border-radius: var(--border-radius-medium);
      }
    </style>

    <dialog
      id="confirm-dialog"
      class="app-dialog"
      aria-labelledby="confirm-dialog-title"
    >
      <div class="app-dialog-header">
        <h3 id="confirm-dialog-title" class="app-dialog-title"></h3>
      </div>
      <div class="app-dialog-body">
        <p id="confirm-dialog-message" class="app-dialog-message"></p>
      </div>
      <div class="app-dialog-footer">
        <button
          id="confirm-dialog-cancel"
          class="btn btn-secondary confirm-dialog-cancel"
        >
          <span class="btn-text">Cancel</span>
        </button>
        <button
          id="confirm-dialog-confirm"
          class="btn btn-primary confirm-dialog-confirm"
        >
          <span class="btn-text">Confirm</span>
        </button>
      </div>
    </dialog>
  </body>
</html>
