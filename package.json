{
  "name": "shakuhachi-ro",
  "version": "0.2.0",
  "description": "Shakuhachi score renderer - vanilla TypeScript implementation",
  "type": "module",
  "private": true,
  "scripts": {
    "predev": "npm run build:wc",
    "dev": "astro dev",
    "build": "npm run build:wc && npm run build:platform",
    "build:wc": "vite build --config vite.embed.config.ts",
    "build:platform": "astro build",
    "preview": "astro preview",
    "type-check": "tsc --noEmit && astro check",
    "lint": "eslint src tests *.{js,ts}",
    "test": "npm run type-check && npm run lint && vitest run",
    "test:coverage": "npm run type-check && npm run lint && vitest run --coverage",
    "pretest:visual": "npm run build:wc",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:visual:report": "playwright show-report tests/visual/reports",
    "test:visual:debug": "playwright test --debug"
  },
  "dependencies": {
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/netlify": "^8.2.6",
    "@github/relative-time-element": "^5.0.0",
    "@lucide/astro": "^1.47.0",
    "@supabase/supabase-js": "^2.39.0",
    "dayjs": "^1.11.19",
    "lucide": "^1.47.0",
    "tweakpane": "^4.0.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.48.0",
    "@tweakpane/core": "^2.0.5",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/coverage-v8": "^5.0.1",
    "@vitest/ui": "^5.0.1",
    "astro": "^7.3.3",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^17.3.0",
    "jsdom": "^29.1.1",
    "playwright": "^1.48.0",
    "prettier": "^3.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
